{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "propwatch-frontend",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "serve",
        "frontend",
        "-p",
        "3456",
        "--no-clipboard"
      ],
      "port": 3456
    },
    {
      "name": "propwatch-worker-local",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "wrangler",
        "dev",
        "--test-scheduled",
        "--local",
        "--port",
        "8787",
        "--cwd",
        "worker"
      ],
      "port": 8787
    }
  ]
}